theorem Sa_pos {d : ℝ} (hd₁ : 7 / 50 - 2 * Rr ≤ d) (hd₂ : d ≤ Rr) : 0 < peval Sac d := by
  rcases le_total d 0 with h0 | h0
  · exact Sa_pos_neg (by linarith) h0
  · rcases le_total d (1 / 20) with h1 | h1
    · exact Sa_pos_small h0 h1
    · exact Sa_pos_right h1 hd₂

lemma endForm_eq (d : ℝ) (x : Fin 3 → ℝ) :
    endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211 A12 R12 d (d + 2 * Rr) x =
    quad3 (dm00 k h A00 R00 d 0) (dm01 k h A01 B01 R101 R201 S201 d (d + 2 * Rr))
      (dm02 k h A01 B01 R101 R201 S201 d (d + 2 * Rr))
      (dm11 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (d + 2 * Rr))
      (dm12 k h A12 R12 d (d + 2 * Rr))
      (dm22 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (-(d + 2 * Rr))) x := rfl

lemma quad3_smul (c m00 m01 m02 m11 m12 m22 : ℝ) (x : Fin 3 → ℝ) :
    c * quad3 m00 m01 m02 m11 m12 m22 x = quad3 (c * m00) (c * m01) (c * m02) (c * m11) (c * m12) (c * m22) x := by
  simp only [quad3]; ring

theorem endForm_nonneg_i {d : ℝ} (hd₁ : -2 * Rr ≤ d) (hd₂ : d ≤ Rr) (hp : d + 2 * Rr ≤ 7 / 50)
    (x : Fin 3 → ℝ) :
    0 ≤ endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211 A12 R12 d (d + 2 * Rr) x := by
  have hD : 0 < Dd d := by
    have := h_pos hd₂; have := r0_pos hd₂; have := s0_pos; simp only [Dd]; positivity
  have hh := h_pos hd₂
  have hr := r0_pos hd₂
  have hl : (-10001 / 50000 : ℝ) ≤ d := by norm_num [Rr] at hd₁ hp ⊢; linarith
  have hu : d ≤ (-3001 / 50000 : ℝ) := by norm_num [Rr] at hd₂ hp ⊢; linarith
  have hP := Pi_pos hl hu
  have hQ := Qi_pos hl hu
  have hS : 0 < peval Sic d := Si_pos (by norm_num [Rr] at hd₁ ⊢; linarith) (by norm_num [Rr] at hu ⊢; linarith)
  have hN : (0 : ℝ) < Ni := by norm_num [Ni]
  have hq : 0 ≤ quad3 (E00 d) (E01 d) (E02 d) (E11i d) (E12 d) (E22 d) x := by
    apply quad3_nonneg_of_minors
    · rw [Pi_eq]; positivity
    · rw [Qi_eq]; positivity
    · rw [Si_eq]; positivity
  have key : Dd d * endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211
      A12 R12 d (d + 2 * Rr) x = quad3 (E00 d) (E01 d) (E02 d) (E11i d) (E12 d) (E22 d) x := by
    rw [endForm_eq, quad3_smul, E00_eq hd₂, E01_eq hd₂, E02_eq hd₂, E11i_eq hd₂ hp, E12_eq hd₂,
      E22_eq hd₂ hd₁]
  rw [← key] at hq
  exact (mul_nonneg_iff_of_pos_left hD).1 hq

theorem endForm_nonneg_a {d : ℝ} (hd₁ : -2 * Rr ≤ d) (hd₂ : d ≤ Rr) (hp : 7 / 50 ≤ d + 2 * Rr)
    (x : Fin 3 → ℝ) :
    0 ≤ endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211 A12 R12 d (d + 2 * Rr) x := by
  have hD : 0 < Dd d := by
    have := h_pos hd₂; have := r0_pos hd₂; have := s0_pos; simp only [Dd]; positivity
  have hh := h_pos hd₂
  have hr := r0_pos hd₂
  have hl : (-3001 / 50000 : ℝ) ≤ d := by norm_num [Rr] at hd₁ hp ⊢; linarith
  have hu : d ≤ (10001 / 100000 : ℝ) := by norm_num [Rr] at hd₂ hp ⊢; linarith
  have hP := Pa_pos hl hu
  have hQ := Qa_pos hl hu
  have hS : 0 < peval Sac d := Sa_pos (by norm_num [Rr] at hl ⊢; linarith) hd₂
  have hN : (0 : ℝ) < Na := by norm_num [Na]
  have hq : 0 ≤ quad3 (E00 d) (E01 d) (E02 d) (E11a d) (E12 d) (E22 d) x := by
    apply quad3_nonneg_of_minors
    · rw [Pa_eq]; positivity
    · rw [Qa_eq]; positivity
    · rw [Sa_eq]; positivity
  have key : Dd d * endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211
      A12 R12 d (d + 2 * Rr) x = quad3 (E00 d) (E01 d) (E02 d) (E11a d) (E12 d) (E22 d) x := by
    rw [endForm_eq, quad3_smul, E00_eq hd₂, E01_eq hd₂, E02_eq hd₂, E11a_eq hd₂ hp, E12_eq hd₂,
      E22_eq hd₂ hd₁]
  rw [← key] at hq
  exact (mul_nonneg_iff_of_pos_left hD).1 hq

theorem endForm_nonneg {d : ℝ} (hd₁ : -2 * Rr ≤ d) (hd₂ : d ≤ Rr) (x : Fin 3 → ℝ) :
    0 ≤ endForm k (3 / 100) (7 / 50) h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211 A12 R12 d (d + 2 * Rr) x := by
  rcases le_total (d + 2 * Rr) (7 / 50) with hp | hp
  · exact endForm_nonneg_i hd₁ hd₂ hp x
  · exact endForm_nonneg_a hd₁ hd₂ hp x

theorem packHat_nonneg {d y : ℝ} (hd₁ : -2 * ((10001 / 100000 : ℚ) : ℝ) ≤ d) (hd₂ : d ≤ ((10001 / 100000 : ℚ) : ℝ))
    (hy₁ : -(d + 2 * ((10001 / 100000 : ℚ) : ℝ)) ≤ y) (hy₂ : y ≤ d + 2 * ((10001 / 100000 : ℚ) : ℝ)) {x : Fin 3 → ℝ}
    (hx : ∀ i, 0 ≤ x i) : 0 ≤ packHat U 0 d y x := by
  have eR : (((10001 / 100000 : ℚ) : ℚ) : ℝ) = Rr := by norm_num [Rr]
  rw [eR] at hd₁ hd₂ hy₁ hy₂
  have hk : k = kap / 2 := k_eq
  have hb1 : h d + k * y ≠ 0 := by
    rw [hk]; simp only [h, kap, bst, Rr] at hd₁ hd₂ hy₁ hy₂ ⊢; nlinarith
  have hb2 : h d + -k * y ≠ 0 := by
    rw [hk]; simp only [h, kap, bst, Rr] at hd₁ hd₂ hy₁ hy₂ ⊢; nlinarith
  rw [packHat_eq d y x hb1 hb2]
  exact packed_base k (3 / 100) (7 / 50) Rr bst h A00 R00 A01 B01 R101 R201 S201 A11 B11 R111 R211
    A12 R12 (by norm_num [k]) (by norm_num) (by norm_num) (by norm_num [Rr]) h_eq
    (by norm_num [bst, k, Rr]) hyp00 hyp01a hyp01b hyp12
    (fun d y h1 h2 h3 h4 h5 => (hyp11 d y h1 h2 h3 h4).1 h5)
    (fun d y h1 h2 h3 h4 h5 => (hyp11 d y h1 h2 h3 h4).2 h5)
    (fun d h1 h2 x => endForm_nonneg h1 h2 x) hd₁ hd₂ hy₁ hy₂ hx

