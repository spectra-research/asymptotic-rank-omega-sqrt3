lemma E22_eq {d : ℝ} (hd : d ≤ Rr) (hd₀ : -2 * Rr ≤ d) :
    Dd d * (dm22 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (-(d + 2 * Rr))) = E22 d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [hinge_eq_zero (by norm_num [Rr] at hd₀ ⊢; linarith), mul_zero, sub_zero]
  simp only [dm22, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E22, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E11i_eq {d : ℝ} (hd : d ≤ Rr) (hp : d + 2 * Rr ≤ 7 / 50) :
    Dd d * (dm11 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (d + 2 * Rr)) = E11i d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [hinge_eq_zero hp]
  simp only [dm11, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E11i, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E11a_eq {d : ℝ} (hd : d ≤ Rr) (hp : 7 / 50 ≤ d + 2 * Rr) :
    Dd d * (dm11 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (d + 2 * Rr)) = E11a d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [show hinge (7 / 50) (d + 2 * Rr) = (d + 2 * Rr - 7 / 50) ^ 2 by
    simp [hinge, max_eq_left (by linarith : (0 : ℝ) ≤ d + 2 * Rr - 7 / 50)]]
  simp only [dm11, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E11a, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring

