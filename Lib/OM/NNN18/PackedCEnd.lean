lemma s0_pos : 0 < s0 := by norm_num [s0, bst, kap, Rr]
lemma r0_pos {d : ℝ} (hd : d ≤ Rr) : 0 < r0 d := by
  simp only [r0]; norm_num [bst, kap, Rr] at hd ⊢; linarith
lemma h_pos {d : ℝ} (hd : d ≤ Rr) : 0 < h d := by
  simp only [h]; norm_num [Rr] at hd ⊢; linarith
lemma hY_eq (d : ℝ) : h d + k * (d + 2 * Rr) = s0 := by simp only [h, k, s0, bst, kap, Rr]; ring
lemma hY_eq' (d : ℝ) : h d + -k * (d + 2 * Rr) = r0 d := by simp only [h, k, r0, bst, kap, Rr]; ring
lemma hY_eq'' (d : ℝ) : h d + -k * -(d + 2 * Rr) = s0 := by simp only [h, k, s0, bst, kap, Rr]; ring
lemma hY_eq''' (d : ℝ) : h d + k * -(d + 2 * Rr) = r0 d := by simp only [h, k, r0, bst, kap, Rr]; ring
lemma h0_eq (d : ℝ) : h d + k * 0 = h d := by ring
lemma h0_eq' (d : ℝ) : h d + -k * 0 = h d := by ring

lemma E00_eq {d : ℝ} (hd : d ≤ Rr) : Dd d * dm00 k h A00 R00 d 0 = E00 d := by
  have h1 := (h_pos hd).ne'
  simp only [dm00, ratPart, h0_eq, h0_eq', mul_zero, add_zero]
  simp only [Dd]
  field_simp
  simp only [E00, peval, A00, R00, h, s0, r0, bst, kap, Rr]
  ring
lemma E01_eq {d : ℝ} (hd : d ≤ Rr) : Dd d * dm01 k h A01 B01 R101 R201 S201 d (d + 2 * Rr) = E01 d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  simp only [dm01, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E01, peval, A01, B01, R101, R201, S201, A12, R12, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E02_eq {d : ℝ} (hd : d ≤ Rr) : Dd d * dm02 k h A01 B01 R101 R201 S201 d (d + 2 * Rr) = E02 d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  simp only [dm02, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E02, peval, A01, B01, R101, R201, S201, A12, R12, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E12_eq {d : ℝ} (hd : d ≤ Rr) : Dd d * dm12 k h A12 R12 d (d + 2 * Rr) = E12 d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  simp only [dm12, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E12, peval, A01, B01, R101, R201, S201, A12, R12, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E22_eq {d : ℝ} (hd : d ≤ Rr) (hd₀ : -2 * Rr ≤ d) :
    Dd d * (dm22 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (-(d + 2 * Rr))) = E22 d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [hinge_eq_zero (by norm_num [Rr] at hd₀ ⊢; linarith), mul_zero, sub_zero]
  simp only [dm22, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E22, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E11i_eq {d : ℝ} (hd : d ≤ Rr) (hp : d + 2 * Rr ≤ 7 / 50) :
    Dd d * (dm11 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (d + 2 * Rr)) = E11i d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [hinge_eq_zero hp]
  simp only [dm11, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E11i, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring
lemma E11a_eq {d : ℝ} (hd : d ≤ Rr) (hp : 7 / 50 ≤ d + 2 * Rr) :
    Dd d * (dm11 k h A11 B11 R111 R211 d (d + 2 * Rr) - 3 / 100 * hinge (7 / 50) (d + 2 * Rr)) = E11a d := by
  have h1 := s0_pos.ne'
  have h2 := (r0_pos hd).ne'
  rw [show hinge (7 / 50) (d + 2 * Rr) = (d + 2 * Rr - 7 / 50) ^ 2 by
    simp [hinge, max_eq_left (by linarith : (0 : ℝ) ≤ d + 2 * Rr - 7 / 50)]]
  simp only [dm11, ratPart, hY_eq, hY_eq', hY_eq'', hY_eq''']
  simp only [Dd]
  generalize hs : s0 = S at h1 ⊢
  generalize hr : r0 d = Rv at h2 ⊢
  field_simp
  subst hs hr
  simp only [E11a, peval, A11, B11, R111, R211, h, k, s0, r0, bst, kap, Rr]
  ring

lemma Pi_eq (d : ℝ) : E11i d = h d * r0 d * peval Pic d := by
  simp only [E11i, Pic, peval, h, r0, bst, kap, Rr]; ring
lemma Qi_eq (d : ℝ) : E11i d * E22 d - E12 d ^ 2 = h d ^ 2 * r0 d ^ 2 * peval Qic d := by
  simp only [E11i, E22, E12, Qic, peval, h, r0, bst, kap, Rr]; ring
lemma Si_eq (d : ℝ) : E00 d * (E11i d * E22 d - E12 d ^ 2) - E01 d * (E01 d * E22 d - E12 d * E02 d)
    + E02 d * (E01 d * E12 d - E11i d * E02 d) = h d ^ 2 * r0 d * (Ni * peval Sic d) := by
  simp only [E00, E01, E02, E11i, E22, E12, Sic, Ni, peval, h, r0, bst, kap, Rr]; push_cast; ring
lemma Pa_eq (d : ℝ) : E11a d = h d * r0 d * peval Pac d := by
  simp only [E11a, Pac, peval, h, r0, bst, kap, Rr]; ring
lemma Qa_eq (d : ℝ) : E11a d * E22 d - E12 d ^ 2 = h d ^ 2 * r0 d ^ 2 * peval Qac d := by
  simp only [E11a, E22, E12, Qac, peval, h, r0, bst, kap, Rr]; ring
lemma Sa_eq (d : ℝ) : E00 d * (E11a d * E22 d - E12 d ^ 2) - E01 d * (E01 d * E22 d - E12 d * E02 d)
    + E02 d * (E01 d * E12 d - E11a d * E02 d) = h d ^ 2 * r0 d * (Na * peval Sac d) := by
  simp only [E00, E01, E02, E11a, E22, E12, Sac, Na, peval, h, r0, bst, kap, Rr]; push_cast; ring

end OM.NNN18.PackC
